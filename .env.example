# Сервер
HOST=0.0.0.0
PORT=8000
DEBUG=True

# База данных (SQLite для разработки, PostgreSQL для продакшена)
DATABASE_URL=sqlite:///./playlist.db

# Файлы
UPLOAD_DIR=uploads
MAX_FILE_SIZE=2147483648
ALLOWED_EXTENSIONS=.mp4,.mkv,.webm

# Безопасность
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=["*"]

# Опционально: базовая аутентификация для админки и /api/videos, /upload, /api/playlist*
# Оставьте пустым, чтобы отключить защиту (только для локальной разработки).
ADMIN_USERNAME=
ADMIN_PASSWORD=
